include LICENSE
include THIRD_PARTY_NOTICES.md
include README.md
include pyproject.toml
include setup.py
recursive-include docs *.md
recursive-include src/super_processor *.py *.pyi *.pyx py.typed
global-exclude *.c
recursive-exclude src/super_processor *.html
global-exclude *.so
global-exclude *.pyd
global-exclude *.dylib
global-exclude *.py[cod]
global-exclude __pycache__
exclude src/super_processor/_version.py
# The built web app. Not in git, so graft it from disk; it comes after the
# *.html exclude above so its index.html stays.
graft src/super_processor/web_dist
